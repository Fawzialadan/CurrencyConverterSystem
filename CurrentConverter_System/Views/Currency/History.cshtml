@model IEnumerable<CurrentConverter_System.Models.CurrencyConversion>

<div class="container mt-5">
    <div class="d-flex justify-content-between mb-3">
        <h4>Recent Conversion History</h4>
        <a asp-controller="Currency" asp-action="Index" class="btn btn-secondary btn-sm">Back to Converter</a>
    </div>

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Amount</th>
                <th>From</th>
                <th>To</th>
                <th>Result</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Amount</td>
                    <td>@item.FromCurrency</td>
                    <td>@item.ToCurrency</td>
                    <td>@item.Result.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>